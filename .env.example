# ==============================================================================
# Cheating Surveillance System - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and customize settings for your local environment.
# Real '.env' files, credentials, keys, and certificates are excluded from Git.
# DO NOT commit production secrets or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Camera & Video Capture Settings
# ------------------------------------------------------------------------------
# Default camera device index (0 = default integrated or primary webcam)
SURVEILLANCE_CAMERA_INDEX=0

# Camera frame resolution (pixels)
SURVEILLANCE_FRAME_WIDTH=640
SURVEILLANCE_FRAME_HEIGHT=480

# Assumed video capture frame rate (FPS)
SURVEILLANCE_DEFAULT_VIDEO_FPS=30.0

# ------------------------------------------------------------------------------
# 2. Timing & Violation Detection Thresholds
# ------------------------------------------------------------------------------
# Sustained violation duration (seconds) before triggering alert & evidence capture
SURVEILLANCE_VIOLATION_THRESHOLD_SEC=3.0

# Mobile phone detection confidence threshold (range: 0.01 - 1.0)
SURVEILLANCE_PHONE_CONFIDENCE_THRESHOLD=0.70

# Mobile phone detection cadence (run YOLO inference every N frames)
SURVEILLANCE_PHONE_DETECTION_INTERVAL_FRAMES=3
SURVEILLANCE_PHONE_DETECTION_CACHE_EXPIRY_FRAMES=6

# Baseline neutral gaze calibration duration (seconds)
SURVEILLANCE_CALIBRATION_DURATION_SEC=5.0
SURVEILLANCE_MIN_CALIBRATION_SAMPLES=10
SURVEILLANCE_MIN_GAZE_CALIBRATION_SAMPLES=10

# ------------------------------------------------------------------------------
# 3. Head Pose Classification Thresholds (degrees)
# ------------------------------------------------------------------------------
# Neutral tolerance bounds (within which head orientation is considered screen-facing)
SURVEILLANCE_HEAD_NEUTRAL_PITCH_THRESHOLD=8.0
SURVEILLANCE_HEAD_NEUTRAL_YAW_THRESHOLD=12.0
SURVEILLANCE_HEAD_NEUTRAL_ROLL_THRESHOLD=5.0

# Non-neutral deviation confirmation bounds
SURVEILLANCE_HEAD_DEVIATION_PITCH_THRESHOLD=10.0
SURVEILLANCE_HEAD_DEVIATION_YAW_THRESHOLD=15.0
SURVEILLANCE_HEAD_DEVIATION_ROLL_THRESHOLD=7.0

# Head pose smoothing history window size
SURVEILLANCE_ANGLE_HISTORY_SIZE=10

# ------------------------------------------------------------------------------
# 4. Pupil & Gaze Settings
# ------------------------------------------------------------------------------
# Pupil detection method: 'adaptive' (Otsu with fallback), 'fixed', or 'otsu'
SURVEILLANCE_PUPIL_DETECTION_METHOD=adaptive
SURVEILLANCE_PUPIL_FIXED_THRESHOLD=50

# Gaze deflection thresholds (normalized pupil ratio deviation)
SURVEILLANCE_GAZE_HORIZONTAL_THRESHOLD=0.16
SURVEILLANCE_GAZE_VERTICAL_THRESHOLD=0.10
SURVEILLANCE_GAZE_UPWARD_THRESHOLD=0.08
SURVEILLANCE_FUSED_GAZE_MIN_CONFIDENCE=0.20

# ------------------------------------------------------------------------------
# 5. Storage & Output Directories
# ------------------------------------------------------------------------------
# Paths may be relative to the repository root or absolute.
# Generated outputs (logs, screenshots, calibrations) are kept in LOG_DIR.
SURVEILLANCE_LOG_DIR=log
SURVEILLANCE_MODEL_DIR=model

# ------------------------------------------------------------------------------
# 6. Offline ML Isolation & Telemetry Suppression
# ------------------------------------------------------------------------------
# Ultralytics offline isolation is enforced automatically in production.
# These variables ensure zero outbound network calls, telemetry, or sync.
YOLO_OFFLINE=True
YOLO_AUTOINSTALL=False
YOLO_VERBOSE=False

# ------------------------------------------------------------------------------
# 7. Evidence Privacy, Storage Protection & Retention
# ------------------------------------------------------------------------------
# Evidence retention period in days (default: 30 days)
SURVEILLANCE_RETENTION_DAYS=30

# Enable automated retention cleanup (False = report only / dry-run by default)
SURVEILLANCE_RETENTION_ENABLED=False

# Enable evidence-at-rest encryption (requires valid key management)
SURVEILLANCE_ENCRYPTION_ENABLED=False
